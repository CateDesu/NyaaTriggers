<TriggernometryExport Version="1">
  <ExportedFolder Id="3555a18e-fde6-43cc-8d91-04f913a546eb" Name="Combat state" Enabled="true">
    <Triggers>
      <Trigger Id="9a90c6ac-e8ef-4554-a779-99cdf2594c56" Name="Probe" Enabled="true" Source="FFXIVNetwork" Sequential="True" RegularExpression="^NYAA_COMBAT (?&lt;label&gt;\w+)$">
        <Actions>
          <Action OrderNumber="1" ActionType="UseTTS" Asynchronous="False" UseTTSTextExpression="${label} state ${_incombat} ${_duration}" />
          <Action OrderNumber="2" ActionType="UseTTS" Asynchronous="False" UseTTSTextExpression="${label} combat">
            <Condition Enabled="true" Grouping="And">
              <ConditionSingle Enabled="true" ExpressionL="${_incombat}" ExpressionTypeL="Numeric" ExpressionR="1" ExpressionTypeR="Numeric" ConditionType="NumericEqual" />
            </Condition>
          </Action>
          <Action OrderNumber="3" ActionType="UseTTS" Asynchronous="False" UseTTSTextExpression="${label} elapsed">
            <Condition Enabled="true" Grouping="And">
              <ConditionSingle Enabled="true" ExpressionL="${_duration}" ExpressionTypeL="Numeric" ExpressionR="0" ExpressionTypeR="Numeric" ConditionType="NumericGreater" />
            </Condition>
          </Action>
          <Action OrderNumber="4" ActionType="UseTTS" Asynchronous="False" UseTTSTextExpression="${label} done" />
        </Actions>
      </Trigger>
      <Trigger Id="15ca6033-b186-49da-915a-4379d39b2c73" Name="Start" Enabled="true" Source="FFXIVNetwork" Sequential="True" RegularExpression="^NYAA_START$">
        <Actions>
          <Action OrderNumber="1" ActionType="ActInteraction" ActOpType="SetCombatState" ActOpBoolParam="True" Asynchronous="False" />
          <Action OrderNumber="2" ActionType="UseTTS" UseTTSTextExpression="started" Asynchronous="False" />
        </Actions>
      </Trigger>
      <Trigger Id="8e309205-fc2c-4f66-b296-22a590a6a131" Name="Stop" Enabled="true" Source="FFXIVNetwork" Sequential="True" RegularExpression="^NYAA_STOP$">
        <Actions>
          <Action OrderNumber="1" ActionType="ActInteraction" ActOpType="SetCombatState" ActOpBoolParam="False" Asynchronous="False" />
          <Action OrderNumber="2" ActionType="UseTTS" UseTTSTextExpression="stopped" Asynchronous="False" />
        </Actions>
      </Trigger>
    </Triggers>
  </ExportedFolder>
</TriggernometryExport>
