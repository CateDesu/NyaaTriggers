<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>gg.xp.nyaa</groupId>
    <artifactId>triggevent-core</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!-- NyaaTriggers sidecar linking the GPL-3.0 event-trigger engine. This artifact is GPL-3.0. Build the engine modules with build.sh first. Trigger modules must be on the runtime classpath for discovery. -->

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tv.version>1.0-SNAPSHOT</tv.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>actimport</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>xivsupport</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>trigger-support</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <!-- The triggers module is an aggregator. Include each trigger code submodule for runtime discovery. -->
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>triggers-general</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>triggers-ew</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>triggers-sb</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>triggers-dt</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>titan-jails</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>easytriggers</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>timelines</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <!-- Include Telesto handlers for engine marker commands without the optional Telesto interface modules. -->
        <dependency>
            <groupId>gg.xp</groupId>
            <artifactId>telesto-core</artifactId>
            <version>${tv.version}</version>
        </dependency>
        <!-- Use the engine's transitive Jackson dependency so the parser and annotations stay compatible across engine updates. -->

    </dependencies>

    <build>
        <finalName>triggevent-core</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>gg.xp.nyaa.TriggeventCore</mainClass>
                                </transformer>
                                <!-- Merge service files used by Groovy, Pico and Reflections. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
